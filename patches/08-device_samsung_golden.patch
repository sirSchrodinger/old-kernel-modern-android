+    user root
+    group root log inet net_admin net_raw
+    disabled
+
+service sirsch_izle /system/bin/sh /system/bin/sirsch-izle.sh
+    class core
+    user root
+    group root log
+    oneshot
+    disabled
+
+service sirsch_ag /system/bin/sh /system/bin/sirsch-ag.sh
+    class core
+    user root
+    group root inet net_admin net_raw wifi
+    oneshot
+    disabled
