diff --git a/overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml b/overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml
new file mode 100644
index 0000000..09a31dd
--- /dev/null
+++ b/overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml
@@ -0,0 +1,21 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- First-boot settings.  This handset is provisioned over the network from a
+     laptop, so it has to come up reachable and without anything in the way. -->
+<resources>
+    <!-- Reachable at first boot: wifi on before anyone touches the screen. -->
+    <bool name="def_wifi_on">true</bool>
+    <!-- 2 = never sleep.  A node that drops off the network when the screen
+         blanks is not a node. -->
+    <integer name="def_wifi_sleep_policy">2</integer>
+
+    <!-- No lock screen: there is nothing on this device worth a swipe, and the
+         stock lock screen is exactly the Android furniture we are removing. -->
+    <bool name="def_lockscreen_disabled">true</bool>
+
+    <bool name="def_screen_brightness_automatic_mode">true</bool>
+    <integer name="def_screen_brightness">56</integer>
+    <integer name="def_screen_off_timeout">30000</integer>
+
+    <bool name="def_backup_enabled">false</bool>
+    <bool name="def_vibrate_when_ringing">false</bool>
+</resources>
