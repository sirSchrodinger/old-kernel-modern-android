 # Currently we dont have e2fsck compiled. So fs check would failed.
 
+# 'nofail' on the secondary partitions: fs_mgr.cpp:1302 only skips ++error_count
+# when no_fail is set, and any error_count makes fs_mgr_mount_all() return
+# FS_MGR_MNTALL_FAIL.  do_mount_all() then never calls queue_fs_event(), so
+# ro.crypto.state stays unset and neither 'on nonencrypted' nor any
+# 'on zygote-start && property:ro.crypto.state=...' block matches - class main
+# is never started.  A missing /efs or /modemfs must break RIL, not booting.
 #<src>                                                	<mnt_point>  <type>  <mnt_flags and options>                     <fs_mgr_flags>
-/dev/block/mmcblk0p22									/system      ext4    rw,noatime                                											wait
-/dev/block/mmcblk0p24									/preload     ext4    rw,noatime																			wait
+/dev/block/mmcblk0p22									/system      ext4    rw,noatime                                											wait,first_stage_mount
+# /preload (mmcblk0p24) is Samsung's preinstalled-app partition.  Nothing in
+# LineageOS reads it, it has no SELinux label so its mount point cannot be
+# baked into the system image, and a mount point that does not exist makes
+# fs_mgr count an error - which fails the whole mount_all and stops the boot.
+#/dev/block/mmcblk0p24									/preload     ext4    rw,noatime																			wait
 /dev/block/mmcblk0p23									/cache       ext4    rw,noatime,nosuid,nodev															wait,formattable
-/dev/block/mmcblk0p11									/efs         ext4    rw,nosuid,nodev,noatime															wait
+/dev/block/mmcblk0p11									/efs         ext4    rw,nosuid,nodev,noatime															wait,nofail
 /dev/block/mmcblk0p25									/data        ext4    rw,noatime,nosuid,nodev,noauto_da_alloc,journal_async_commit,errors=continue		wait,formattable,encryptable=/efs/metadata
 
 # External SD
@@ -18,10 +28,22 @@
 # recovery
 /dev/block/mmcblk0p20                           /boot				emmc		defaults		recoveryonly
 /dev/block/mmcblk0p21                           /recovery			emmc		defaults		recoveryonly
-/dev/block/mmcblk0p12							/modemfs     		ext4    	rw,nosuid,nodev,noatime		wait,first_stage_mount
+/dev/block/mmcblk0p12							/modemfs     		ext4    	rw,nosuid,nodev,noatime		wait,nofail
 
 # OTG
 /devices/platform/musb-ux500.0/musb-hdrc*  	      auto	   auto	    defaults		  voldmanaged=usb:auto
 
-# zRAM
-/dev/block/zram0                                      none         swap    defaults               zramsize=134217728
+# zRAM - DISABLED, and it never actually worked on this kernel.
+# golden_defconfig asks for CONFIG_ZRAM=y, but Kconfig drops it silently: ZRAM
+# depends on ZSMALLOC, and the only zsmalloc in this tree (drivers/staging) is
+# the pre-3.9 x86-only one - its zs_map_object() uses raw set_pte() plus
+# __flush_tlb_one(), with no ARM path - and it is not even sourced from
+# drivers/staging/Kconfig.  On top of that the zram driver here is a 3.15-era
+# backport calling zs_get_total_pages() and the 3-argument zs_map_object(),
+# neither of which the old zsmalloc has.  So /dev/block/zram0 is never created
+# and this line was a no-op claiming 288 MB that did not exist.
+# fs_mgr_mount_all() skips swap entries and swapon_all failures are non-fatal,
+# so it did no harm either - it just was not true.
+# Re-enabling means backporting a modern zsmalloc to this 3.4 ARM kernel and
+# adapting the driver's calls.  That is a real kernel patch, not a config flip.
+#/dev/block/zram0                                      none         swap    defaults               zramsize=301989888
