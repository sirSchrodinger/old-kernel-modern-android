+/*
+ * Scatter-gather support, backported from the Android 8 binder.
+ *
+ * libhwbinder sends every hwbinder transaction as BC_TRANSACTION_SG and hangs
+ * its out-of-line data off BINDER_TYPE_PTR objects, so a driver without this
+ * answers -EINVAL to every HIDL call and no HAL can ever register.
+ *
+ * The objects in a transaction are no longer all the same size, so the offsets
+ * array has to be walked with the size of each object taken into account, and
+ * they must appear in increasing order with no overlap - which is what
+ * binder_validate_object and the off_min check in binder_transaction enforce.
+ */
+
+/* This kernel predates SIZE_MAX in linux/kernel.h. */
+#define BINDER_SIZE_MAX ((size_t)~0UL)
+
+/**
+ * binder_validate_object() - size of the object at @offset, or 0 if it is bad.
+ *
+ * Rejects anything whose header does not fit, is misaligned, has an unknown
+ * type, or whose body would run past the end of the buffer.
+ */
+static size_t binder_validate_object(struct binder_buffer *buffer, size_t offset)
+{
+	struct binder_object_header *hdr;
+	size_t object_size = 0;
+
+	if (buffer->data_size < sizeof(*hdr) ||
+	    offset > buffer->data_size - sizeof(*hdr) ||
+	    !IS_ALIGNED(offset, sizeof(void *)))
+		return 0;
+
+	hdr = (struct binder_object_header *)(buffer->data + offset);
+	switch (hdr->type) {
+	case BINDER_TYPE_BINDER:
+	case BINDER_TYPE_WEAK_BINDER:
+	case BINDER_TYPE_HANDLE:
+	case BINDER_TYPE_WEAK_HANDLE:
+	case BINDER_TYPE_FD:
+		object_size = sizeof(struct flat_binder_object);
+		break;
+	case BINDER_TYPE_PTR:
+		object_size = sizeof(struct binder_buffer_object);
+		break;
+	case BINDER_TYPE_FDA:
+		object_size = sizeof(struct binder_fd_array_object);
+		break;
+	default:
+		return 0;
+	}
+	if (offset <= buffer->data_size - object_size &&
+	    buffer->data_size >= object_size)
+		return object_size;
+	return 0;
+}
+
+/**
+ * binder_validate_ptr() - fetch object @index from the offsets array and make
+ * sure it really is a BINDER_TYPE_PTR.
+ *
+ * Only objects the driver has already walked past are addressable, hence the
+ * @num_valid bound: a buffer may only refer to a parent that came before it.
+ */
+static struct binder_buffer_object *binder_validate_ptr(
+		struct binder_buffer *b, size_t index,
+		size_t *start, size_t num_valid)
+{
+	struct binder_buffer_object *buffer_obj;
+	size_t *offp;
+
+	if (index >= num_valid)
+		return NULL;
+
+	offp = start + index;
+	buffer_obj = (struct binder_buffer_object *)(b->data + *offp);
+	if (buffer_obj->type != BINDER_TYPE_PTR)
+		return NULL;
+
+	return buffer_obj;
+}
+
+/**
+ * binder_validate_fixup() - is it legal to write a fixup at @fixup_offset?
+ *
+ * Fixups must be strictly forward-only, so that a caller cannot rewrite a
+ * pointer the driver has already translated.  @last_obj is the object the
+ * previous fixup landed in and @last_min_offset the first offset still free in
+ * it; walking up the parent chain from @last_obj to @buffer establishes the
+ * lowest offset that is still untouched.
+ */
+static bool binder_validate_fixup(struct binder_buffer *b,
+				  size_t *objects_start,
+				  struct binder_buffer_object *buffer,
+				  size_t fixup_offset,
+				  struct binder_buffer_object *last_obj,
+				  size_t last_min_offset)
+{
+	if (!last_obj) {
+		/* Nothing to fix up in */
+		return false;
+	}
+
+	while (last_obj != buffer) {
+		/*
+		 * Safe to retrieve the parent of last_obj, since it has already
+		 * been verified by the driver on its own pass.
+		 */
+		if ((last_obj->flags & BINDER_BUFFER_FLAG_HAS_PARENT) == 0)
+			return false;
+		last_min_offset = last_obj->parent_offset + sizeof(void *);
+		last_obj = (struct binder_buffer_object *)
+			(b->data + *(objects_start + last_obj->parent));
+	}
+	return (fixup_offset >= last_min_offset);
