@@ -216,9 +237,198 @@ static void android_work(struct work_struct *data)
 }
 
 
+/*-------------------------------------------------------------------------*/
+
+/* Connect and disconnect were open-coded in enable_store().  FunctionFS needs
+ * to do the same thing from its ready/closed callbacks, and those can nest
+ * with a userspace write to "enable", so it becomes a counter rather than a
+ * flag. */
