diff --git a/drivers/battery/abb_charger.c b/drivers/battery/abb_charger.c
index 0d861696..95423eef 100644
--- a/drivers/battery/abb_charger.c
+++ b/drivers/battery/abb_charger.c
@@ -34,6 +34,76 @@
 
 #include <linux/battery/charger/abb_charger.h>
 
+/*
+ * Input current ceiling, in mA, overriding the per-cable-type value from
+ * platform data.  0 keeps the stock behaviour.
+ *
+ * A PC port enumerates as USB and the driver then holds the input to the
+ * 500 mA the spec allows, which is less than this handset draws while Android
+ * is booting - measured -300 mA at the battery with the charger attached, so
+ * every boot attempt runs the cell down.  Desktop ports in practice deliver
+ * well over 500 mA.
+ *
+ * Raising the ceiling is self-limiting rather than reckless: if the port
+ * cannot hold the current, VBUS sags, the VBUS-drop handler still runs and
+ * ab8500_handle_vbus_voltage_drop_work() steps the input back down through
+ * ab8500_chg_vbus_in_curr_map[] on its own.  That mechanism is untouched.
+ *
+ * Cmdline:  abb_charger.giris_akimi=900
+ * Runtime:  echo 900 > /sys/module/abb_charger/parameters/giris_akimi
+ *           (takes effect the next time the cable is attached)
+ */
+static int ab8500_chg_set_input_curr(struct ab8500_charger_info *di,
+				     int ich_in, bool init);
+static void ab8500_chg_set_charge(struct ab8500_charger_info *di, bool enable);
+
+static struct ab8500_charger_info *sirsch_di;
+
+static int giris_akimi;
+
+/*
+ * Applied the moment it is written, not only at the next cable attach.
+ *
+ * This has to work from sysfs because the kernel command line does not reach
+ * us: this bootloader forwards only some of the keys from the boot image's
+ * cmdline.  Measured 25 August - the image carried
+ *   enforcing=0 androidboot.selinux=permissive root=/dev/ram0 rw
+ *   androidboot.hardware=samsunggolden androidboot.wificountrycode=tr
+ *   abb_charger.zayif_vbus=1 abb_charger.giris_akimi=900 buildvariant=userdebug
+ * and /proc/cmdline came back with androidboot.selinux and
+ * androidboot.hardware only.  Everything else, including both of these
+ * parameters, was dropped - which is why the charging fix looked like it was
+ * in place for a day while never once being active.
+ *
+ * init writes both through /sys/module/abb_charger/parameters/ instead.
+ */
+static int giris_akimi_yaz(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_int(val, kp);
+
+	if (ret)
+		return ret;
+	if (sirsch_di && giris_akimi > 0) {
+		sirsch_di->vbus_drop_count = 0;
+		sirsch_di->input_current_limit = giris_akimi;
+		dev_info(sirsch_di->dev,
+			 "input current set to %d mA (abb_charger.giris_akimi)\n",
+			 giris_akimi);
+		ab8500_chg_set_input_curr(sirsch_di, giris_akimi, true);
+		ab8500_chg_set_charge(sirsch_di, true);
+	}
+	return 0;
+}
+
+static struct kernel_param_ops giris_akimi_ops = {
+	.set = giris_akimi_yaz,
+	.get = param_get_int,
+};
+
+module_param_cb(giris_akimi, &giris_akimi_ops, &giris_akimi, 0644);
+MODULE_PARM_DESC(giris_akimi,
+	"input current ceiling in mA, applied on write (default 0 = off)");
+
 static int ab8500_voltage_to_regval(int voltage)
 {
 	int i;
@@ -660,6 +730,12 @@ static int ab8500_chg_en(struct ab8500_charger_info *di, int enable)
 		di->input_current_limit =
 			di->pdata->charging_current[di->cable_type].
 			input_current_limit;
+		if (giris_akimi > 0) {
+			dev_info(di->dev,
+				 "input current %d mA -> %d mA (abb_charger.giris_akimi)\n",
+				 di->input_current_limit, giris_akimi);
+			di->input_current_limit = giris_akimi;
+		}
 		ret = ab8500_chg_set_input_curr(di,
 			di->input_current_limit, false);
 		if (ret) {
@@ -750,6 +826,29 @@ static struct ab8500_charger_event_list ab8500_event_list[] = {
 	{"BTEMP_LOW", F_BTEMP_LOW, 0},
 };
 
+/*
+ * On this handset the AB8500's USB_CHARGER_NOT_OK comparator trips because
+ * VBUS measures 4616 mV at the connector - under its window - and the driver's
+ * response is to stop charging outright, so current_now stays negative on a
+ * cable that could still deliver something.  With this set the flag is still
+ * recorded and logged, but the charge is left running.
+ *
+ * Off by default on purpose.  It overrides a charger-side safety signal on a
+ * cell built in 2013, and that is the owner's call rather than the driver's.
+ * The cut-outs that protect the battery itself - VBUS over-voltage, battery
+ * over-voltage, thermal protection and the charge watchdog - are separate
+ * flags and are untouched by this.
+ *
+ * Cmdline:  abb_charger.zayif_vbus=1
+ * Runtime:  echo 1 > /sys/module/abb_charger/parameters/zayif_vbus
+ */
+static int zayif_vbus;
+module_param(zayif_vbus, int, 0644);
+MODULE_PARM_DESC(zayif_vbus,
+	"keep charging when VBUS trips USB_CHARGER_NOT_OK (default 0)");
+
+
+
 /**
  * ab8500_fg_reenable_charging() - function for re-enabling charger explicitly
  * @di:		pointer to the ab8500_fg structure
@@ -1367,9 +1466,17 @@ static void ab8500_chg_check_hw_failure_work(struct work_struct *work)
 			   to aviod duplicated notification */
 			di->flags.irq_flag_shadow |=
 				ab8500_event_list[i].flag_mask;
+			if (zayif_vbus && ab8500_event_list[i].flag_mask ==
+					F_USB_CHARGER_NOT_OK) {
+				dev_info(di->dev,
+					 "%s reported, charge kept running "
+					 "(abb_charger.zayif_vbus=1)\n",
+					 ab8500_event_list[i].name);
+			} else {
 			dev_info(di->dev, "CHARGER STOP by %s\n",
 				 ab8500_event_list[i].name);
 			ab8500_chg_set_charge(di, false);
+			}
 			if ((di->flags.irq_flag & F_CHG_WD_EXP) ||
 			    (di->flags.irq_flag & F_MAIN_THERMAL_PROT) ||
 #ifndef CONFIG_MACH_SEC_GOLDEN
@@ -2405,6 +2512,7 @@ static int __devinit ab8500_chg_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	platform_set_drvdata(pdev, di);
+	sirsch_di = di;
 	di->dev = &pdev->dev;
 	di->parent = dev_get_drvdata(pdev->dev.parent);
 
