diff --git a/arch/arm/include/asm/memory.h b/arch/arm/include/asm/memory.h
index fcb57574..baf51910 100644
--- a/arch/arm/include/asm/memory.h
+++ b/arch/arm/include/asm/memory.h
@@ -37,7 +37,24 @@
  */
 #define PAGE_OFFSET		UL(CONFIG_PAGE_OFFSET)
 #define TASK_SIZE		(UL(CONFIG_PAGE_OFFSET) - UL(0x01000000))
-#define TASK_UNMAPPED_BASE	(UL(CONFIG_PAGE_OFFSET) / 3)
+/*
+ * Stock ARM puts the bottom-up mmap base at PAGE_OFFSET/3 = 0x40000000, and on
+ * this handset that is where zygote suffocates.  Measured 25 August from
+ * /proc/<zygote>/maps: above 0x40000000 the space is cut into ~1300 mappings
+ * whose largest hole is 19.5 MB, while 300 MB (0x1000-0x12c00000) and 532 MB
+ * (0x1ec00000-0x40000000) sit completely free underneath - and neither the
+ * bottom-up search nor the top-down walk's fallback ever looks below
+ * TASK_UNMAPPED_BASE.  So a 31 MB mapping of resources.arsc fails:
+ *   E filemap       : mmap(4161536,32626436) failed: Out of memory
+ *   E system_server : Failed to open 'resources.arsc' in framework-res.apk
+ *   java.lang.IllegalStateException: Failed to create system AssetManager
+ * and system_server dies on every fork.
+ *
+ * 16 MB instead: it hands the allocator those ~830 MB and costs nothing, since
+ * the executable and its brk live at ELF_ET_DYN_BASE (TASK_SIZE/3*2) far above
+ * this and are unaffected.
+ */
+#define TASK_UNMAPPED_BASE	UL(0x01000000)
 
 /*
  * The maximum size of a 26-bit user space task.
diff --git a/arch/arm/kernel/process.c b/arch/arm/kernel/process.c
index c678fb9e..4c3ea641 100644
--- a/arch/arm/kernel/process.c
+++ b/arch/arm/kernel/process.c
@@ -697,6 +697,31 @@ const char *arch_vma_name(struct vm_area_struct *vma)
 
 extern struct page *get_signal_page(void);
 
+/*
+ * install_special_mapping() stores this pointer itself in
+ * vma->vm_private_data, and special_mapping_fault() dereferences it on every
+ * fault on the sigpage - which happens long after this function has returned.
+ * The original code passed &page, the address of a local, so the fault read a
+ * kernel stack slot belonging to whatever ran next and called get_page() on
+ * whatever integer was sitting there.
+ *
+ * Measured on golden, 24 August: a process crashes, the signal handler returns
+ * through the sigpage, and
+ *   BUG: Bad page map in process rild  pte:7d42d59f
+ *   addr:5849c000 vm_flags:00040075 vma->vm_ops->fault: special_mapping_fault
+ *   Unable to handle kernel paging request at virtual address f1080090
+ *   PC is at __get_page_tail   LR is at special_mapping_fault
+ *   Kernel panic - not syncing: Fatal exception
+ * pfn 0x7d42d is past the end of RAM on this board, and a second boot produced
+ * a different garbage pfn - it is whatever the dead stack frame happened to
+ * hold.  Every crashing process took the whole handset down with it, roughly
+ * forty seconds into each boot.
+ *
+ * get_signal_page() returns the same single page for the lifetime of the
+ * system, so one file-scope holder is enough - this is what mainline does.
+ */
+static struct page *sigpage_holder;
+
 int arch_setup_additional_pages(struct linux_binprm *bprm, int uses_interp)
 {
 	struct mm_struct *mm = current->mm;
@@ -707,6 +732,7 @@ int arch_setup_additional_pages(struct linux_binprm *bprm, int uses_interp)
 	page = get_signal_page();
 	if (!page)
 		return -ENOMEM;
+	sigpage_holder = page;
 
 	down_write(&mm->mmap_sem);
 	addr = get_unmapped_area(NULL, 0, PAGE_SIZE, 0, 0);
@@ -717,7 +743,7 @@ int arch_setup_additional_pages(struct linux_binprm *bprm, int uses_interp)
 
 	ret = install_special_mapping(mm, addr, PAGE_SIZE,
 		VM_READ | VM_EXEC | VM_MAYREAD | VM_MAYWRITE | VM_MAYEXEC,
-		&page);
+		&sigpage_holder);
 
 	if (ret == 0)
 		mm->context.sigpage = addr;
diff --git a/arch/arm/mm/mmap.c b/arch/arm/mm/mmap.c
index a6df86d8..9e48dbe0 100644
--- a/arch/arm/mm/mmap.c
+++ b/arch/arm/mm/mmap.c
@@ -105,9 +105,26 @@ arch_get_unmapped_area(struct file *filp, unsigned long addr,
 	        mm->cached_hole_size = 0;
 	}
 
-	if ((current->flags & PF_RANDOMIZE) &&
-	    !(current->personality & ADDR_NO_RANDOMIZE))
-		addr += (get_random_int() % ((1 << mmap_rnd_bits) - 1)) << PAGE_SHIFT;
+	/*
+	 * No per-allocation randomisation here.
+	 *
+	 * This vendor addition offset every single mmap by up to
+	 * ((1 << mmap_rnd_bits) - 1) pages - 1020 KB with the shipped
+	 * mmap_rnd_bits=8 - so a process with a lot of mappings ends up with
+	 * its address space sprayed across the whole range instead of packed.
+	 * Measured on golden, 25 August: zygote had 1467 mappings totalling
+	 * 501 MB spread evenly over the full 3 GB, every 128 MB slice holding
+	 * a few megabytes, and no hole larger than 49 MB left.  ART then could
+	 * not place a 64 MB heap space or the 93 MB boot image:
+	 *   Check failed: main_mem_map_2.IsValid() Failed anonymous
+	 *     mmap(0x0, 67108864, 0x3, 0x22, -1, 0): Out of memory
+	 * and system_server died on framework-res.apk's 31 MB resources.arsc.
+	 *
+	 * Address-space randomisation still happens - arch_pick_mmap_layout()
+	 * randomises mm->mmap_base once per process, which is what mainline
+	 * does and what mmap_rnd_bits is for.  Only the per-call offset, which
+	 * mainline never had, is gone.
+	 */
 
