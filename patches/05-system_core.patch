@@ -284,6 +284,25 @@ static Result<Success> do_insmod(const BuiltinArguments& args) {
     if (fd == -1) return ErrnoError() << "open(\"" << filename << "\") failed";
 
     int rc = syscall(__NR_finit_module, fd.get(), options.c_str(), flags);
+    if (rc == -1 && errno == ENOSYS) {
+        // finit_module() arrived in kernel 3.8.  This device runs 3.4, so every
+        // insmod in the init scripts failed with ENOSYS and no module was ever
+        // loaded - which took Wi-Fi with it, since dhd.ko is what creates wlan0.
+        // init_module() has been there since forever and takes the image in
+        // memory instead of by descriptor, so read the file and use that.
+        // MODULE_INIT_IGNORE_* have no equivalent here; nothing in this tree's
+        // init scripts passes -f, so nothing is lost.
+        std::string module_image;
+        if (!android::base::ReadFdToString(fd, &module_image)) {
+            return ErrnoError() << "couldn't read \"" << filename << "\"";
+        }
+        rc = syscall(__NR_init_module, module_image.data(), module_image.size(),
+                     options.c_str());
+        if (rc == -1) {
+            return ErrnoError() << "init_module for \"" << filename << "\" failed";
+        }
+        return Success();
+    }
     if (rc == -1) return ErrnoError() << "finit_module for \"" << filename << "\" failed";
 
     return Success();
