diff --git a/libutils/legacy_abi_shim.cpp b/libutils/legacy_abi_shim.cpp
new file mode 100644
index 0000000..c408a7f
--- /dev/null
+++ b/libutils/legacy_abi_shim.cpp
@@ -0,0 +1,42 @@
+/*
+ * Vtable padding slots that libutils exported until Oreo.
+ *
+ * VectorImpl and SortedVectorImpl used to end with eight empty virtual
+ * methods reserved for future ABI growth.  They were deleted upstream, but
+ * every pre-Oreo blob that links libutils still imports them, and the dlopen
+ * fails outright when they cannot be resolved.  On this device that hits:
+ *
+ *   audio.primary.DB8520H.so   16 symbols
+ *   libaudiopolicy_sec.so      16 symbols
+ *   libwvm.so                  16 symbols
+ *
+ * and the audio one is why audioserver dies with a null-pointer SIGSEGV in
+ * AudioFlinger::AudioFlinger(): the HAL never loads, so mDevicesFactoryHal is
+ * null.  Everything else those blobs import from VectorImpl (add, clear,
+ * removeItemsAt, the constructors) still exists; only the reserved slots are
+ * gone.
+ *
+ * Defined by mangled name rather than by re-adding the methods to the class:
+ * adding virtuals back would change the vtable of the libutils that the rest
+ * of the platform is compiled against, which is a much bigger change than the
+ * problem justifies.  The bodies are empty, which is exactly what they were.
+ */
+
+#define RESERVED(sym) extern "C" void sym(void) {}
+
+RESERVED(_ZN7android10VectorImpl19reservedVectorImpl1Ev)
+RESERVED(_ZN7android10VectorImpl19reservedVectorImpl2Ev)
+RESERVED(_ZN7android10VectorImpl19reservedVectorImpl3Ev)
+RESERVED(_ZN7android10VectorImpl19reservedVectorImpl4Ev)
+RESERVED(_ZN7android10VectorImpl19reservedVectorImpl5Ev)
+RESERVED(_ZN7android10VectorImpl19reservedVectorImpl6Ev)
+RESERVED(_ZN7android10VectorImpl19reservedVectorImpl7Ev)
+RESERVED(_ZN7android10VectorImpl19reservedVectorImpl8Ev)
+RESERVED(_ZN7android16SortedVectorImpl25reservedSortedVectorImpl1Ev)
+RESERVED(_ZN7android16SortedVectorImpl25reservedSortedVectorImpl2Ev)
+RESERVED(_ZN7android16SortedVectorImpl25reservedSortedVectorImpl3Ev)
+RESERVED(_ZN7android16SortedVectorImpl25reservedSortedVectorImpl4Ev)
+RESERVED(_ZN7android16SortedVectorImpl25reservedSortedVectorImpl5Ev)
+RESERVED(_ZN7android16SortedVectorImpl25reservedSortedVectorImpl6Ev)
+RESERVED(_ZN7android16SortedVectorImpl25reservedSortedVectorImpl7Ev)
+RESERVED(_ZN7android16SortedVectorImpl25reservedSortedVectorImpl8Ev)
