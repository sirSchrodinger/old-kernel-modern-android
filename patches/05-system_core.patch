diff --git a/libcutils/atomic_legacy.c b/libcutils/atomic_legacy.c
new file mode 100644
index 0000000..a32af81
--- /dev/null
+++ b/libcutils/atomic_legacy.c
@@ -0,0 +1,100 @@
+/*
+ * Out-of-line android_atomic_* for pre-Oreo vendor blobs.
+ *
+ * These were real exported symbols of libcutils until Android 8; today
+ * <cutils/atomic.h> only has ANDROID_ATOMIC_INLINE definitions, so nothing
+ * exports them any more.  Every blob on this device is from 2013 and two of
+ * them still import the symbols:
+ *
+ *   gralloc.montblanc.so         android_atomic_or
+ *                                android_atomic_release_cas
+ *                                android_atomic_release_store
+ *   camera.vendor.montblanc.so   android_atomic_inc
+ *                                android_atomic_dec
+ *
+ * Without them the dlopen fails:
+ *   E HAL: load: module=/system/lib/hw/gralloc.montblanc.so
+ *   E HAL: dlopen failed: cannot locate symbol "android_atomic_release_cas"
+ * and that one failure takes down the whole framework: no gralloc means no
+ * graphics composer, so SurfaceFlinger aborts with "failed to get hwcomposer
+ * service", and zygote dies with it.
+ *
+ * bionic's linker does carry TARGET_LD_SHIM_LIBS support, but it is behind a
+ * compile-time LD_SHIM_LIBS define that this build system never sets, so a
+ * shim library would need build-system plumbing as well.  Both blobs already
+ * link libcutils, so putting the symbols back where they used to live is the
+ * smaller and more predictable change.
+ *
+ * The whole family is defined, not only the five that are imported today:
+ * finding the next missing one costs a full flash-and-boot round on this
+ * handset, and the extra definitions cost nothing.
+ *
+ * Semantics are copied from <cutils/atomic.h> exactly - in particular the CAS
+ * functions return 0 on SUCCESS, which is the opposite of what the name
+ * suggests and is what the callers expect.
+ */
+
+#include <stdatomic.h>
+#include <stdint.h>
+
+static inline volatile atomic_int_least32_t* to_a32(volatile int32_t* addr) {
+    return (volatile atomic_int_least32_t*)addr;
+}
+
+static inline volatile const atomic_int_least32_t* to_ca32(volatile const int32_t* addr) {
+    return (volatile const atomic_int_least32_t*)addr;
+}
+
+int32_t android_atomic_inc(volatile int32_t* addr) {
+    return atomic_fetch_add_explicit(to_a32(addr), 1, memory_order_release);
+}
+
+int32_t android_atomic_dec(volatile int32_t* addr) {
+    return atomic_fetch_sub_explicit(to_a32(addr), 1, memory_order_release);
+}
+
+int32_t android_atomic_add(int32_t value, volatile int32_t* addr) {
+    return atomic_fetch_add_explicit(to_a32(addr), value, memory_order_release);
+}
+
+int32_t android_atomic_and(int32_t value, volatile int32_t* addr) {
+    return atomic_fetch_and_explicit(to_a32(addr), value, memory_order_release);
+}
+
+int32_t android_atomic_or(int32_t value, volatile int32_t* addr) {
+    return atomic_fetch_or_explicit(to_a32(addr), value, memory_order_release);
+}
+
+int32_t android_atomic_acquire_load(volatile const int32_t* addr) {
+    return atomic_load_explicit(to_ca32(addr), memory_order_acquire);
+}
+
+int32_t android_atomic_release_load(volatile const int32_t* addr) {
+    atomic_thread_fence(memory_order_seq_cst);
+    return atomic_load_explicit(to_ca32(addr), memory_order_relaxed);
+}
+
+void android_atomic_acquire_store(int32_t value, volatile int32_t* addr) {
+    atomic_store_explicit(to_a32(addr), value, memory_order_relaxed);
+    atomic_thread_fence(memory_order_seq_cst);
+}
+
+void android_atomic_release_store(int32_t value, volatile int32_t* addr) {
+    atomic_store_explicit(to_a32(addr), value, memory_order_release);
+}
+
+/* Returns 0 on success - see the note above. */
+int android_atomic_acquire_cas(int32_t oldvalue, int32_t newvalue,
+                               volatile int32_t* addr) {
+    return !atomic_compare_exchange_strong_explicit(
+        to_a32(addr), &oldvalue, newvalue,
+        memory_order_acquire, memory_order_acquire);
+}
+
+/* Returns 0 on success - see the note above. */
+int android_atomic_release_cas(int32_t oldvalue, int32_t newvalue,
+                               volatile int32_t* addr) {
+    return !atomic_compare_exchange_strong_explicit(
+        to_a32(addr), &oldvalue, newvalue,
+        memory_order_release, memory_order_relaxed);
+}
