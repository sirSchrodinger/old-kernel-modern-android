@@ -153,6 +175,7 @@ IPower* HIDL_FETCH_IPower(const char* /* name */) {
         return nullptr;
     }
 
+    bool opened = false;
     if (!hw_module->methods || !hw_module->methods->open) {
         power_module = reinterpret_cast<power_module_t*>(
             const_cast<hw_module_t*>(hw_module));
@@ -164,8 +187,9 @@ IPower* HIDL_FETCH_IPower(const char* /* name */) {
             ALOGE("Passthrough failed to load legacy HAL.");
             return nullptr;
         }
+        opened = true;
     }
-    return new Power(power_module);
+    return new Power(power_module, opened);
 }
 
 } // namespace implementation
