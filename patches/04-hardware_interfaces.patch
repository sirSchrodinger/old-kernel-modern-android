diff --git a/power/1.0/default/Power.cpp b/power/1.0/default/Power.cpp
index 51f87f5..0b75eb6 100644
--- a/power/1.0/default/Power.cpp
+++ b/power/1.0/default/Power.cpp
@@ -29,13 +29,35 @@ namespace power {
 namespace V1_0 {
 namespace implementation {
 
-Power::Power(power_module_t *module) : mModule(module) {
+Power::Power(power_module_t *module, bool opened)
+        : mModule(module), mOpened(opened) {
     if (mModule)
         mModule->init(mModule);
 }
 
+// hw_get_module() does not allocate anything.  For a HAL without
+// methods->open it returns HAL_MODULE_INFO_SYM itself, which lives in the
+// dlopen'd library's .data section, so `delete(mModule)` reaches je_free()
+// with a pointer that never came from the heap.  That is not a leak fixed
+// late, it is a segfault - and in passthrough mode it happens inside whoever
+// dropped the last strong reference.  Here that is system_server:
+// setUpPowerStatsLocked() calls IPower::getService(), lets the temporary sp<>
+// die at the end of the `if`, and the whole process dies with it.
+//
+// Measured on golden, 25 August: tombstone_27, tid batterystats-wo,
+//   je_free+924 <- ~Power <- RefBase::decStrong <- setUpPowerStatsLocked
+//   <- getRailEnergyPowerStats <- BatteryStatsService.fillRailDataStats
+// system_server was killed on every BatteryStats rail-stats update, so
+// sys.boot_completed was never reached and the boot animation ran forever.
+//
+// The other branch is not deletable either: methods->open() hands back a
+// hw_device_t whose contract is common.close(), not operator delete.
 Power::~Power() {
-    delete(mModule);
+    if (!mOpened || !mModule)
+        return;
+    hw_device_t *dev = reinterpret_cast<hw_device_t *>(mModule);
+    if (dev->close)
+        dev->close(dev);
 }
 
